# Neonline frontend configuration.
# Copy to `.env.local` (git-ignored) and adjust. Every value below is a real
# cluster setting - the site never falls back to a simulated wallet.

# testnet | devnet | mainnet-beta
VITE_SOLANA_CLUSTER=testnet

# Cluster RPC endpoint used for balances and for broadcasting signed transactions.
VITE_SOLANA_RPC_URL=https://api.testnet.solana.com

# On-chain prediction program. Leave empty until a deployment exists: with no
# program id the app signs the position note as a real memo transaction instead,
# and the UI says so rather than pretending the market program settled it.
VITE_SOLANA_PROGRAM_ID=

VITE_SOLANA_EXPLORER_URL=https://explorer.solana.com/?cluster=testnet
